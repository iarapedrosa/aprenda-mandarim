[
  {"id":"f001","hanzi":"你好！","pinyin":"Nǐ hǎo!","traducao":"Olá!","nota":"O cumprimento mais comum. Com pessoas mais velhas ou desconhecidas, use 您好 (nín hǎo)."},
  {"id":"f002","hanzi":"早上好！","pinyin":"Zǎoshang hǎo!","traducao":"Bom dia!","nota":"Usado de manhã cedo, mais ou menos até as 10h."},
  {"id":"f003","hanzi":"谢谢！","pinyin":"Xièxie!","traducao":"Obrigado(a)!","nota":"O segundo 谢 é falado no tom neutro, bem leve."},
  {"id":"f004","hanzi":"不客气。","pinyin":"Bú kèqi.","traducao":"De nada.","nota":"Literalmente \"não seja cerimonioso\". 不 vira bú antes do 4º tom."},
  {"id":"f005","hanzi":"不好意思。","pinyin":"Bù hǎoyìsi.","traducao":"Com licença; desculpe o incômodo.","nota":"Mais leve que 对不起. Ótimo para chamar alguém ou pedir licença."},
  {"id":"f006","hanzi":"没关系。","pinyin":"Méi guānxi.","traducao":"Não tem problema.","nota":"Resposta clássica a um pedido de desculpas."},
  {"id":"f007","hanzi":"请问，厕所在哪儿？","pinyin":"Qǐngwèn, cèsuǒ zài nǎr?","traducao":"Por favor, onde fica o banheiro?","nota":"请问 (\"permita-me perguntar\") abre qualquer pergunta a um desconhecido."},
  {"id":"f008","hanzi":"多少钱？","pinyin":"Duōshao qián?","traducao":"Quanto custa?","nota":"Pergunta essencial para compras."},
  {"id":"f009","hanzi":"太贵了！","pinyin":"Tài guì le!","traducao":"Caro demais!","nota":"太…了 = \"demais\". Útil para pechinchar."},
  {"id":"f010","hanzi":"便宜一点儿吧。","pinyin":"Piányi yìdiǎnr ba.","traducao":"Faz mais barato, vai.","nota":"吧 no fim deixa o pedido mais suave."},
  {"id":"f011","hanzi":"我听不懂。","pinyin":"Wǒ tīng bu dǒng.","traducao":"Não entendo (o que ouço).","nota":"听 (ouvir) + 不懂 (não entender)."},
  {"id":"f012","hanzi":"请说慢一点儿。","pinyin":"Qǐng shuō màn yìdiǎnr.","traducao":"Fale mais devagar, por favor.","nota":"Talvez a frase mais útil para quem está aprendendo!"},
  {"id":"f013","hanzi":"请再说一遍。","pinyin":"Qǐng zài shuō yí biàn.","traducao":"Repita, por favor.","nota":"遍 conta \"vezes do começo ao fim\"."},
  {"id":"f014","hanzi":"这个用中文怎么说？","pinyin":"Zhège yòng Zhōngwén zěnme shuō?","traducao":"Como se diz isto em chinês?","nota":"Aponte para algo e pergunte."},
  {"id":"f015","hanzi":"我是巴西人。","pinyin":"Wǒ shì Bāxī rén.","traducao":"Sou brasileiro(a).","nota":"巴西 = Brasil; 人 = pessoa."},
  {"id":"f016","hanzi":"我在学中文。","pinyin":"Wǒ zài xué Zhōngwén.","traducao":"Estou aprendendo chinês.","nota":"在 antes do verbo indica ação em andamento."},
  {"id":"f017","hanzi":"加油！","pinyin":"Jiāyóu!","traducao":"Força! Vamos lá!","nota":"Literalmente \"pôr combustível\". Serve para torcida e incentivo."},
  {"id":"f018","hanzi":"没问题！","pinyin":"Méi wèntí!","traducao":"Sem problema!"},
  {"id":"f019","hanzi":"好久不见！","pinyin":"Hǎojiǔ bú jiàn!","traducao":"Quanto tempo!","nota":"Literalmente \"muito tempo sem ver\"."},
  {"id":"f020","hanzi":"慢慢来。","pinyin":"Mànmàn lái.","traducao":"Vai com calma.","nota":"Para tranquilizar alguém (ou você mesmo nos estudos)."},
  {"id":"f021","hanzi":"小心！","pinyin":"Xiǎoxīn!","traducao":"Cuidado!"},
  {"id":"f022","hanzi":"等一下。","pinyin":"Děng yíxià.","traducao":"Espera um pouco.","nota":"一下 suaviza: \"rapidinho\"."},
  {"id":"f023","hanzi":"我饿了。","pinyin":"Wǒ è le.","traducao":"Estou com fome.","nota":"了 indica mudança de estado: \"fiquei com fome\"."},
  {"id":"f024","hanzi":"我渴了。","pinyin":"Wǒ kě le.","traducao":"Estou com sede."},
  {"id":"f025","hanzi":"好吃！","pinyin":"Hǎochī!","traducao":"Que gostoso!","nota":"好 + 吃 (comer). Para bebidas: 好喝 (hǎohē)."},
  {"id":"f026","hanzi":"干杯！","pinyin":"Gānbēi!","traducao":"Saúde! (brinde)","nota":"Literalmente \"secar o copo\"."},
  {"id":"f027","hanzi":"生日快乐！","pinyin":"Shēngrì kuàilè!","traducao":"Feliz aniversário!"},
  {"id":"f028","hanzi":"新年快乐！","pinyin":"Xīnnián kuàilè!","traducao":"Feliz ano novo!","nota":"No Ano Novo Chinês também se diz 春节快乐 (Chūnjié kuàilè)."},
  {"id":"f029","hanzi":"恭喜！","pinyin":"Gōngxǐ!","traducao":"Parabéns!"},
  {"id":"f030","hanzi":"祝你好运！","pinyin":"Zhù nǐ hǎoyùn!","traducao":"Boa sorte!","nota":"祝 = desejar (algo bom a alguém)."},
  {"id":"f031","hanzi":"一路平安！","pinyin":"Yílù píng'ān!","traducao":"Boa viagem!","nota":"Literalmente \"o caminho todo em paz\"."},
  {"id":"f032","hanzi":"我爱你。","pinyin":"Wǒ ài nǐ.","traducao":"Eu te amo."},
  {"id":"f033","hanzi":"我想你。","pinyin":"Wǒ xiǎng nǐ.","traducao":"Sinto sua falta.","nota":"想 também significa \"pensar\" e \"querer\"."},
  {"id":"f034","hanzi":"真的吗？","pinyin":"Zhēn de ma?","traducao":"Sério?"},
  {"id":"f035","hanzi":"当然！","pinyin":"Dāngrán!","traducao":"Claro!"},
  {"id":"f036","hanzi":"我不知道。","pinyin":"Wǒ bù zhīdào.","traducao":"Eu não sei."},
  {"id":"f037","hanzi":"随便。","pinyin":"Suíbiàn.","traducao":"Tanto faz.","nota":"Cuidado: dependendo do tom de voz, soa indiferente."},
  {"id":"f038","hanzi":"算了。","pinyin":"Suàn le.","traducao":"Deixa pra lá."},
  {"id":"f039","hanzi":"太好了！","pinyin":"Tài hǎo le!","traducao":"Que ótimo!"},
  {"id":"f040","hanzi":"辛苦了！","pinyin":"Xīnkǔ le!","traducao":"Obrigado pelo esforço!","nota":"Dito a quem trabalhou duro. Não tem tradução exata em português."},
  {"id":"f041","hanzi":"欢迎！","pinyin":"Huānyíng!","traducao":"Bem-vindo(a)!"},
  {"id":"f042","hanzi":"请进！","pinyin":"Qǐng jìn!","traducao":"Entre, por favor!"},
  {"id":"f043","hanzi":"请坐。","pinyin":"Qǐng zuò.","traducao":"Sente-se, por favor."},
  {"id":"f044","hanzi":"你叫什么名字？","pinyin":"Nǐ jiào shénme míngzi?","traducao":"Como você se chama?"},
  {"id":"f045","hanzi":"认识你很高兴。","pinyin":"Rènshi nǐ hěn gāoxìng.","traducao":"Prazer em te conhecer."},
  {"id":"f046","hanzi":"你是哪国人？","pinyin":"Nǐ shì nǎ guó rén?","traducao":"De que país você é?"},
  {"id":"f047","hanzi":"你多大了？","pinyin":"Nǐ duō dà le?","traducao":"Quantos anos você tem?","nota":"Para crianças, use 你几岁了？(Nǐ jǐ suì le?)"},
  {"id":"f048","hanzi":"现在几点？","pinyin":"Xiànzài jǐ diǎn?","traducao":"Que horas são?"},
  {"id":"f049","hanzi":"今天星期几？","pinyin":"Jīntiān xīngqī jǐ?","traducao":"Que dia da semana é hoje?"},
  {"id":"f050","hanzi":"你住在哪儿？","pinyin":"Nǐ zhù zài nǎr?","traducao":"Onde você mora?"},
  {"id":"f051","hanzi":"我迷路了。","pinyin":"Wǒ mílù le.","traducao":"Eu me perdi."},
  {"id":"f052","hanzi":"能帮我一下吗？","pinyin":"Néng bāng wǒ yíxià ma?","traducao":"Pode me ajudar?"},
  {"id":"f053","hanzi":"我要这个。","pinyin":"Wǒ yào zhège.","traducao":"Quero este.","nota":"Aponte e diga: resolve muita compra!"},
  {"id":"f054","hanzi":"买单！","pinyin":"Mǎidān!","traducao":"A conta, por favor!","nota":"No restaurante. Também se diz 结账 (jiézhàng)."},
  {"id":"f055","hanzi":"可以刷卡吗？","pinyin":"Kěyǐ shuākǎ ma?","traducao":"Posso pagar com cartão?"},
  {"id":"f056","hanzi":"我不吃肉。","pinyin":"Wǒ bù chī ròu.","traducao":"Eu não como carne."},
  {"id":"f057","hanzi":"不要辣。","pinyin":"Bú yào là.","traducao":"Sem pimenta, por favor.","nota":"Muito útil em restaurantes de Sichuan e Hunan!"},
  {"id":"f058","hanzi":"有点儿辣。","pinyin":"Yǒudiǎnr là.","traducao":"Está um pouco apimentado.","nota":"有点儿 antes de adjetivo costuma indicar algo negativo."},
  {"id":"f059","hanzi":"我吃饱了。","pinyin":"Wǒ chī bǎo le.","traducao":"Estou satisfeito(a).","nota":"Literalmente \"comi até ficar cheio\"."},
  {"id":"f060","hanzi":"你吃饭了吗？","pinyin":"Nǐ chī fàn le ma?","traducao":"Já comeu?","nota":"Cumprimento tradicional, como um \"tudo bem?\"."},
  {"id":"f061","hanzi":"我很累。","pinyin":"Wǒ hěn lèi.","traducao":"Estou muito cansado(a)."},
  {"id":"f062","hanzi":"我生病了。","pinyin":"Wǒ shēngbìng le.","traducao":"Fiquei doente."},
  {"id":"f063","hanzi":"我头疼。","pinyin":"Wǒ tóu téng.","traducao":"Estou com dor de cabeça.","nota":"头 = cabeça; 疼 = doer."},
