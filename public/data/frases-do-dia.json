  {"id":"f077","hanzi":"明天见！","pinyin":"Míngtiān jiàn!","traducao":"Até amanhã!","nota":"Funciona com qualquer tempo: 下午见 (até a tarde), 星期一见 (até segunda)."},
  {"id":"f078","hanzi":"一会儿见！","pinyin":"Yíhuìr jiàn!","traducao":"Até daqui a pouco!"},
  {"id":"f079","hanzi":"保重！","pinyin":"Bǎozhòng!","traducao":"Se cuida!"},
  {"id":"f080","hanzi":"路上小心。","pinyin":"Lùshang xiǎoxīn.","traducao":"Cuidado no caminho."},
  {"id":"f081","hanzi":"周末愉快！","pinyin":"Zhōumò yúkuài!","traducao":"Bom fim de semana!"},
  {"id":"f082","hanzi":"学而时习之。","pinyin":"Xué ér shí xí zhī.","traducao":"Aprender e praticar sempre.","nota":"Frase de Confúcio — perfeita para quem estuda todo dia!"},
  {"id":"f083","hanzi":"熟能生巧。","pinyin":"Shú néng shēng qiǎo.","traducao":"A prática leva à perfeição.","nota":"成语: \"a familiaridade gera habilidade\"."},
  {"id":"f084","hanzi":"活到老，学到老。","pinyin":"Huó dào lǎo, xué dào lǎo.","traducao":"Viver e aprender até a velhice."},
  {"id":"f085","hanzi":"千里之行，始于足下。","pinyin":"Qiān lǐ zhī xíng, shǐ yú zú xià.","traducao":"Uma jornada de mil li começa com um passo.","nota":"Frase de Lǎozǐ. 里 (lǐ) é uma antiga medida de distância."},
  {"id":"f086","hanzi":"慢慢学，不着急。","pinyin":"Mànmàn xué, bù zháojí.","traducao":"Aprenda devagar, sem pressa."},
  {"id":"f087","hanzi":"马马虎虎。","pinyin":"Mǎmǎhūhū.","traducao":"Mais ou menos.","nota":"Literalmente \"cavalo cavalo tigre tigre\"."},
  {"id":"f088","hanzi":"还可以。","pinyin":"Hái kěyǐ.","traducao":"Dá pra levar; razoável."},
  {"id":"f089","hanzi":"我也是。","pinyin":"Wǒ yě shì.","traducao":"Eu também."},
  {"id":"f090","hanzi":"你呢？","pinyin":"Nǐ ne?","traducao":"E você?","nota":"呢 devolve a pergunta."},
  {"id":"f091","hanzi":"你会说英语吗？","pinyin":"Nǐ huì shuō Yīngyǔ ma?","traducao":"Você fala inglês?"},
  {"id":"f092","hanzi":"我会说一点儿中文。","pinyin":"Wǒ huì shuō yìdiǎnr Zhōngwén.","traducao":"Falo um pouco de chinês."},
  {"id":"f093","hanzi":"你的中文很好！","pinyin":"Nǐ de Zhōngwén hěn hǎo!","traducao":"Seu chinês é muito bom!","nota":"Você vai ouvir muito isso! A resposta humilde é 哪里哪里."},
  {"id":"f094","hanzi":"哪里哪里。","pinyin":"Nǎli nǎli.","traducao":"Que nada! (resposta a elogio)","nota":"Literalmente \"onde? onde?\" — modéstia tradicional."},
  {"id":"f095","hanzi":"不用谢。","pinyin":"Bú yòng xiè.","traducao":"Não precisa agradecer."},
  {"id":"f096","hanzi":"打扰一下。","pinyin":"Dǎrǎo yíxià.","traducao":"Com licença (desculpe interromper)."},
  {"id":"f097","hanzi":"我明白了。","pinyin":"Wǒ míngbai le.","traducao":"Entendi."},
  {"id":"f098","hanzi":"有空吗？","pinyin":"Yǒu kòng ma?","traducao":"Tem um tempinho?"},
  {"id":"f099","hanzi":"一起去吧！","pinyin":"Yìqǐ qù ba!","traducao":"Vamos juntos!"},
  {"id":"f100","hanzi":"我请客。","pinyin":"Wǒ qǐngkè.","traducao":"Eu pago (é por minha conta).","nota":"Na China, é comum disputar quem paga a conta!"},
  {"id":"f101","hanzi":"早点儿休息。","pinyin":"Zǎo diǎnr xiūxi.","traducao":"Vá descansar cedo.","nota":"Forma carinhosa de dar boa-noite."},
  {"id":"f102","hanzi":"晚安！","pinyin":"Wǎn'ān!","traducao":"Boa noite! (antes de dormir)","nota":"Só para se despedir à noite."},
  {"id":"f103","hanzi":"我很喜欢中国菜。","pinyin":"Wǒ hěn xǐhuan Zhōngguó cài.","traducao":"Eu gosto muito de comida chinesa."},
  {"id":"f104","hanzi":"你喜欢做什么？","pinyin":"Nǐ xǐhuan zuò shénme?","traducao":"O que você gosta de fazer?"},
  {"id":"f105","hanzi":"我们是好朋友。","pinyin":"Wǒmen shì hǎo péngyou.","traducao":"Somos bons amigos."},
  {"id":"f106","hanzi":"今天是个好日子。","pinyin":"Jīntiān shì ge hǎo rìzi.","traducao":"Hoje é um bom dia.","nota":"日子 = dia (na vida); também é nome de uma canção famosa."}
]
